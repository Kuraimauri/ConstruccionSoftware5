<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_04_ConsumoServicioWeb.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Button x:Name="btnConsultar" Text="Consultar" Clicked="OnConsultarClicked" />
            <Button x:Name="btnInsertar" Text="Insertar" Clicked="OnInsertarClicked" />
            <Label Text="ID:" FontSize="Large" />
            <Entry x:Name="txtID" Keyboard="Numeric" />
            <Label Text="Titulo:" FontSize="Large" />
            <Entry x:Name="txtTitulo" />
            <Label Text="Contenido" FontSize="Large" />
            <Entry x:Name="txtContenido" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
